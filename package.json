{
  "name": "tagmi-ai-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "echo \"No tests defined\" && exit 0",
    "generate:proto": "protoc -I proto proto/*.proto --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/grpc --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true",
    "codegen": "npm run generate:proto",
    "prebuild": "npm run generate:proto"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "kafkajs": "^2.2.4",
    "@grpc/grpc-js": "^1.8.17",
    "@grpc/proto-loader": "^0.7.6"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6",
    "ts-proto": "^1.120.0"
  }
}